# ============================================================
# Environment config — copy this to .env
# NEVER commit .env to git
# ============================================================

# ⚠️  ANTHROPIC_API_KEY — DO NOT SET THIS
# Claude Code authenticates via your Claude Pro subscription (browser login).
# If you set this variable, Claude Code will IGNORE your subscription and
# bill your API account per token instead. Leave it blank.
ANTHROPIC_API_KEY=

# ⚠️  OPENAI_API_KEY — DO NOT SET THIS
# Codex CLI authenticates via your ChatGPT Plus subscription (codex auth).
# If you set this variable, Codex will IGNORE your subscription and
# bill your API account per token instead. Leave it blank.
OPENAI_API_KEY=

# ✅  KAGGLE — Required only for downloading competition data
# Get from: https://www.kaggle.com/settings -> API -> Create New Token
# This downloads a kaggle.json — place it at ~/.kaggle/kaggle.json
# OR fill in the values below.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# GEMINI — Not required. The system works without it.
# Only set if you want programmatic Gemini access beyond free limits.
GEMINI_API_KEY=
